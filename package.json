{
  "name": "codex-app-mcp",
  "version": "0.3.0",
  "description": "Thin stdio MCP server exposing codex / codex-reply over a long-lived codex app-server child",
  "type": "module",
  "bin": {
    "codex-app-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/generate-schema.mjs && npm run build",
    "test": "vitest run",
    "smoke": "bash bin/smoke.sh"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
